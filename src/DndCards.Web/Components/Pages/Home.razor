@page "/"
@rendermode InteractiveServer
@inject DndCards.Web.Services.LocalizationService I18n
@implements IDisposable

<PageTitle>@I18n.T("nav.dashboard") | @I18n.T("app.title")</PageTitle>

<div class="container-fluid py-2">
    <!-- Hero Banner -->
    <div class="glass-panel p-4 p-md-5 mb-4 position-relative overflow-hidden" style="background: radial-gradient(circle at top right, rgba(218, 165, 32, 0.15), rgba(22, 27, 34, 0.95) 70%); border: 1px solid rgba(218, 165, 32, 0.3);">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill bg-dark border border-secondary mb-3">
                    <span class="badge bg-warning text-dark">@I18n.T("home.hero.pill")</span>
                    <span class="small text-muted">@I18n.T("home.hero.subpill")</span>
                </div>
                <h1 class="display-5 fw-bold text-light mb-3">@I18n.T("home.hero.title")</h1>
                <p class="lead text-muted mb-4">
                    @I18n.T("home.hero.desc")
                </p>
                <div class="d-flex flex-wrap gap-3">
                    <a href="cards" class="btn btn-warning px-4 py-2 fw-semibold d-flex align-items-center gap-2 shadow-sm">
                        <span>🃏</span> @I18n.T("home.hero.cta_start")
                    </a>
                    <button type="button" class="btn btn-outline-light px-4 py-2" data-bs-toggle="modal" data-bs-target="#legalModal">
                        ⚖️ @I18n.T("home.hero.cta_legal")
                    </button>
                </div>
            </div>
            <div class="col-lg-4 text-center mt-4 mt-lg-0">
                <!-- Visual Miniature Card Deck Showcase -->
                <div class="d-inline-block position-relative p-3">
                    <div class="preview-card-frame red shadow-lg" style="transform: rotate(3deg); width: 220px; min-height: 330px;">
                        <div class="preview-header">@(I18n.CurrentLanguage == "en" ? "Fireball" : "Feuerball")</div>
                        <div class="preview-body">
                            <div class="preview-stat-row"><span class="preview-stat-label">@(I18n.CurrentLanguage == "en" ? "Cost:" : "Kosten:")</span> @(I18n.CurrentLanguage == "en" ? "1 Action" : "1 Aktion")</div>
                            <div class="preview-stat-row"><span class="preview-stat-label">@(I18n.CurrentLanguage == "en" ? "Range:" : "Reichweite:")</span> 150 ft</div>
                            <div class="preview-effect">@(I18n.CurrentLanguage == "en" ? "8d6 fire damage in a 20-ft sphere. Dexterity save halves." : "8d6 Feuerschaden in einer 20-Fuß-Kugel. Rettungswurf: Geschicklichkeit halbiert.")</div>
                            <div class="preview-fluff">@(I18n.CurrentLanguage == "en" ? "\"A bright streak flashes from your finger into a fiery explosion.\"" : "\"Ein helles Aufblitzen, gefolgt von loderndem Inferno.\"")</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Feature Cards -->
    <div class="row g-4 mb-4">
        <div class="col-md-4">
            <div class="glass-panel p-4 h-100">
                <div class="fs-1 mb-3">⚡</div>
                <h4 class="text-light fw-bold">@I18n.T("home.feat1.title")</h4>
                <p class="text-muted small">
                    @I18n.T("home.feat1.desc")
                </p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="glass-panel p-4 h-100">
                <div class="fs-1 mb-3">🎯</div>
                <h4 class="text-light fw-bold">@I18n.T("home.feat2.title")</h4>
                <p class="text-muted small">
                    @I18n.T("home.feat2.desc")
                </p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="glass-panel p-4 h-100">
                <div class="fs-1 mb-3">🪙</div>
                <h4 class="text-light fw-bold">@I18n.T("home.feat3.title")</h4>
                <p class="text-muted small">
                    @I18n.T("home.feat3.desc")
                </p>
            </div>
        </div>
    </div>

    <!-- Legal & Nominative Fair-Use Notice -->
    <div class="glass-panel p-3 text-muted small d-flex align-items-center justify-content-between flex-wrap gap-2">
        <div class="d-flex align-items-center gap-2">
            <span>ℹ️</span>
            <span>@I18n.T("home.footer_note")</span>
        </div>
        <a href="cards" class="text-amber fw-semibold text-decoration-none">@I18n.T("home.link_create")</a>
    </div>
</div>

@code {
    protected override void OnInitialized()
    {
        I18n.OnLanguageChanged += StateHasChanged;
    }

    public void Dispose()
    {
        I18n.OnLanguageChanged -= StateHasChanged;
    }
}
