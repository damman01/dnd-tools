@inherits LayoutComponentBase
@inject DndCards.Web.Services.LocalizationService I18n
@implements IDisposable

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <header class="top-row px-4 d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-dark-subtle text-light border border-secondary">v1.2</span>
                <span class="badge bg-gradient-amber text-dark fw-bold">@I18n.T("app.compatible_badge")</span>
            </div>
            <div class="d-flex align-items-center gap-2">
                <!-- Unit System Switcher -->
                <div class="btn-group btn-group-sm" role="group" aria-label="Unit system selection" title="@I18n.T("gen.units.label")">
                    <button type="button" class="btn @(I18n.CurrentUnitSystem == UnitSystem.Metric ? "btn-info text-dark fw-bold" : "btn-outline-secondary text-light")"
                            @onclick='() => SetUnit(UnitSystem.Metric)'>
                        📏 m
                    </button>
                    <button type="button" class="btn @(I18n.CurrentUnitSystem == UnitSystem.Imperial ? "btn-info text-dark fw-bold" : "btn-outline-secondary text-light")"
                            @onclick='() => SetUnit(UnitSystem.Imperial)'>
                        📐 ft
                    </button>
                    <button type="button" class="btn @(I18n.CurrentUnitSystem == UnitSystem.Both ? "btn-info text-dark fw-bold" : "btn-outline-secondary text-light")"
                            @onclick='() => SetUnit(UnitSystem.Both)' title="@I18n.T("gen.units.both")">
                        🔄 m &amp; ft
                    </button>
                </div>

                <!-- Language Switcher -->
                <div class="btn-group btn-group-sm" role="group" aria-label="Language selection">
                    <button type="button" class="btn @(I18n.CurrentLanguage == "de" ? "btn-warning text-dark fw-bold" : "btn-outline-secondary text-light")"
                            @onclick='() => SetLang("de")'>
                        🇩🇪 DE
                    </button>
                    <button type="button" class="btn @(I18n.CurrentLanguage == "en" ? "btn-warning text-dark fw-bold" : "btn-outline-secondary text-light")"
                            @onclick='() => SetLang("en")'>
                        🇬🇧 EN
                    </button>
                </div>

                <button type="button" class="btn btn-sm btn-outline-light d-flex align-items-center gap-1 ms-1" data-bs-toggle="modal" data-bs-target="#legalModal">
                    <span>⚖️</span> <span>@I18n.T("topbar.legal_button")</span>
                </button>
            </div>
        </header>

        <article class="content px-4 py-3">
            @Body
        </article>

        <footer class="app-footer text-center py-3 px-4 text-muted small border-top">
            <div class="container-fluid d-flex flex-wrap justify-content-between align-items-center gap-2">
                <span>&copy; @DateTime.Now.Year <strong>@I18n.T("app.title")</strong> &ndash; @I18n.T("footer.tagline")</span>
                <span>
                    <button type="button" class="btn btn-link btn-sm text-secondary p-0 text-decoration-none" data-bs-toggle="modal" data-bs-target="#legalModal">
                        @I18n.T("footer.legal_link")
                    </button>
                </span>
            </div>
        </footer>
    </main>
</div>

<!-- Modal für rechtliche Hinweise & Disclaimer -->
<div class="modal fade" id="legalModal" tabindex="-1" aria-labelledby="legalModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content legal-modal-content text-light">
            <div class="modal-header border-secondary">
                <h5 class="modal-title fw-bold text-light" id="legalModalLabel">⚖️ @I18n.T("legal.modal_title")</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-toggle="modal" data-bs-target="#legalModal" aria-label="Schließen"></button>
            </div>
            <div class="modal-body">
                <h6 class="fw-bold text-amber">@I18n.T("legal.trademark_title")</h6>
                <p class="small text-muted mb-3">
                    @I18n.T("legal.trademark_body")
                </p>

                <h6 class="fw-bold text-amber">@I18n.T("legal.ugc_title")</h6>
                <p class="small text-muted mb-3">
                    @I18n.T("legal.ugc_body")
                </p>

                <h6 class="fw-bold text-amber">@I18n.T("legal.srd_title")</h6>
                <p class="small text-muted mb-0">
                    @I18n.T("legal.srd_body")
                </p>
            </div>
            <div class="modal-footer border-secondary">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#legalModal">@I18n.T("legal.close")</button>
            </div>
        </div>
    </div>
</div>

@code {
    protected override void OnInitialized()
    {
        I18n.OnLanguageChanged += StateHasChanged;
        I18n.OnUnitSystemChanged += StateHasChanged;
    }

    private void SetLang(string lang)
    {
        I18n.SetLanguage(lang);
    }

    private void SetUnit(DndCards.Web.Services.UnitSystem unit)
    {
        I18n.SetUnitSystem(unit);
    }

    public void Dispose()
    {
        I18n.OnLanguageChanged -= StateHasChanged;
        I18n.OnUnitSystemChanged -= StateHasChanged;
    }
}

<div id="blazor-error-ui" data-nosnippet>
    Ein unerwarteter Fehler ist aufgetreten.
    <a href="." class="reload">Neu laden</a>
    <span class="dismiss">🗙</span>
</div>
