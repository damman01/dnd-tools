@inject DndCards.Web.Services.LocalizationService I18n
@implements IDisposable

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand d-flex align-items-center gap-2" href="">
            <span class="brand-icon">⚔️</span>
            <span class="brand-title">@I18n.T("app.title")</span>
        </a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="nav-icon" aria-hidden="true">🏠</span> @I18n.T("nav.dashboard")
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="cards">
                <span class="nav-icon" aria-hidden="true">🃏</span> @I18n.T("nav.generator")
            </NavLink>
        </div>
    </nav>
</div>

@code {
    protected override void OnInitialized()
    {
        I18n.OnLanguageChanged += StateHasChanged;
    }

    public void Dispose()
    {
        I18n.OnLanguageChanged -= StateHasChanged;
    }
}

