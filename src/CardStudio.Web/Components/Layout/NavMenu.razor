@inject CardStudio.Web.Services.LocalizationService I18n
@implements IDisposable

<div class="top-row ps-3 pe-3 navbar navbar-dark d-flex justify-content-between align-items-center">
    <a class="navbar-brand d-flex align-items-center gap-2 text-decoration-none" href="">
        <span class="brand-icon fs-5">⚔️</span>
        <span class="brand-title fw-bold text-amber">@I18n.T("app.title")</span>
    </a>
    <button title="Navigation menu" class="navbar-toggler d-md-none border-secondary" @onclick="ToggleNavMenu">
        <span class="navbar-toggler-icon"></span>
    </button>
</div>

<div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="nav flex-column p-2 gap-1">
        <div class="nav-item">
            <NavLink class="nav-link rounded px-3 py-2 d-flex align-items-center gap-2" href="" Match="NavLinkMatch.All">
                <span class="nav-icon fs-6" aria-hidden="true">🏠</span>
                <span class="nav-text">@I18n.T("nav.dashboard")</span>
            </NavLink>
        </div>

        <div class="nav-item">
            <NavLink class="nav-link rounded px-3 py-2 d-flex align-items-center gap-2" href="cards">
                <span class="nav-icon fs-6" aria-hidden="true">🃏</span>
                <span class="nav-text">@I18n.T("nav.generator")</span>
            </NavLink>
        </div>
    </nav>
</div>

@code {
    private bool collapseNavMenu = true;
    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    protected override void OnInitialized()
    {
        I18n.OnLanguageChanged += StateHasChanged;
    }

    public void Dispose()
    {
        I18n.OnLanguageChanged -= StateHasChanged;
    }
}

