@page "/cards"
@rendermode InteractiveServer
@using System.Text.Json
@using CardStudio.Shared.Models
@using CardStudio.Shared.Contracts
@using CardStudio.Web.Services
@inject CardHtmlBuilder CardHtmlBuilder
@inject DndBeyondImportService DndBeyondImportService
@inject UsageLimitService UsageLimitService
@inject CardDeckStateService DeckState
@inject LocalizationService I18n
@inject CardTranslationService TranslationService
@inject ICardApiClient ApiClient
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>@I18n.T("gen.title") | @I18n.T("app.title")</PageTitle>

<div class="container-fluid px-0">
    <!-- Header & Action Ribbon -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4 pb-3 border-bottom border-secondary">
        <div>
            <h2 class="fw-bold mb-1 d-flex align-items-center gap-2">
                <span class="text-amber">🃏</span>
                <span>@I18n.T("gen.title")</span>
            </h2>
            <p class="text-muted small mb-0">
                @I18n.T("gen.subtitle")
            </p>
        </div>
        <div class="d-flex flex-wrap align-items-center gap-2">
            <button class="btn btn-outline-light btn-sm d-flex align-items-center gap-1" @onclick="AddBlankCard">
                <span>➕</span> <span>@I18n.T("gen.btn.add")</span>
            </button>
            <button class="btn btn-outline-info btn-sm d-flex align-items-center gap-1" @onclick="TranslateDeck" title="Übersetzt Kartenbegriffe zwischen Deutsch und Englisch">
                <span>🌐</span> <span>@I18n.T("gen.btn.translate_deck") (@(I18n.CurrentLanguage == "de" ? "DE" : "EN"))</span>
            </button>
            <button class="btn btn-outline-primary btn-sm d-flex align-items-center gap-1" @onclick="ConvertDeckUnits" title="Rechnet Reichweiten im Deck in die gewählte Maßeinheit um (m ⇄ ft)">
                <span>📏</span> <span>@(I18n.CurrentUnitSystem switch { UnitSystem.Metric => "→ Metrisch (m)", UnitSystem.Imperial => "→ Imperial (ft)", _ => "→ Beide (m & ft)" })</span>
            </button>
            <button class="btn btn-outline-secondary btn-sm" @onclick="DownloadDeckJson">
                <span>💾</span> @I18n.T("gen.btn.save_json")
            </button>
            <button class="btn btn-outline-secondary btn-sm" @onclick="DownloadHtml">
                <span>🌐</span> @I18n.T("gen.btn.export_html")
            </button>
            <button class="btn btn-outline-warning btn-sm" @onclick="GeneratePng" disabled="@_isGenerating">
                <span>🖼️</span> @(_isGenerating ? "..." : I18n.T("gen.btn.export_png"))
            </button>
            <button class="btn btn-warning btn-sm fw-semibold shadow-sm" @onclick="GeneratePdf" disabled="@_isGenerating">
                <span>📄</span> @(_isGenerating ? "..." : I18n.T("gen.btn.export_pdf"))
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_statusMessage))
    {
        <div class="alert @(_statusIsError ? "alert-danger" : "alert-info") alert-dismissible fade show d-flex align-items-center justify-content-between shadow-sm" role="alert">
            <div>
                <span class="me-2">@(_statusIsError ? "⚠️" : "ℹ️")</span>
                @_statusMessage
            </div>
            <button type="button" class="btn-close" @onclick="() => _statusMessage = null" aria-label="Close"></button>
        </div>
    }

    <!-- Import / Tool Bar Accordion -->
    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="glass-panel p-3 h-100">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="fw-semibold small text-light">📥 @I18n.T("gen.import.deck_json")</span>
                    <span class="badge bg-secondary-subtle text-secondary small">JSON</span>
                </div>
                <InputFile class="form-control form-control-sm" OnChange="OnDeckJsonSelected" accept=".json" />
            </div>
        </div>
        <div class="col-md-6">
            <div class="glass-panel p-3 h-100">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="fw-semibold small text-light">⚡ @I18n.T("gen.import.dndbeyond")</span>
                    <span class="badge bg-warning text-dark small fw-bold">Auto-Parse</span>
                </div>
                <InputFile class="form-control form-control-sm" OnChange="OnDndBeyondJsonSelected" accept=".json" />
            </div>
        </div>
    </div>

    <!-- Main Workspace: Split View (Cards & Live Preview) -->
    <div class="row g-4">
        <!-- Card Deck Overview & Details -->
        <div class="col-lg-8">
            <div class="glass-panel p-3 mb-3">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div class="d-flex align-items-center gap-2">
                        <span class="fw-bold text-light">@I18n.T("gen.deck_title")</span>
                        <input class="form-control form-control-sm text-light fw-bold" style="max-width: 250px;" @bind="_deck.Title" />
                    </div>
                    <span class="badge bg-dark border border-secondary text-light">
                        @_deck.Cards.Count @I18n.T("gen.cards_count")
                    </span>
                </div>

                @if (_deck.Cards.Count == 0)
                {
                    <div class="text-center py-5 text-muted">
                        <div class="fs-1 mb-2">🃏</div>
                        <h5>@I18n.T("gen.no_cards")</h5>
                        <p class="small mb-3">@I18n.T("gen.no_cards_desc")</p>
                        <button class="btn btn-outline-warning btn-sm" @onclick="AddBlankCard">+ @I18n.T("gen.btn.add")</button>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-dark table-hover table-sm align-middle mb-0" style="background: transparent;">
                            <thead>
                                <tr class="text-muted small text-uppercase">
                                    <th style="width: 40px;">@I18n.T("table.th.num")</th>
                                    <th>@I18n.T("table.th.name")</th>
                                    <th style="width: 110px;">@I18n.T("table.th.type")</th>
                                    <th style="width: 100px;">@I18n.T("table.th.cost")</th>
                                    <th style="width: 100px;">@I18n.T("table.th.range")</th>
                                    <th style="width: 140px;">@I18n.T("table.th.trackers")</th>
                                    <th style="width: 110px;" class="text-end">@I18n.T("table.th.actions")</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (var i = 0; i < _deck.Cards.Count; i++)
                                {
                                    var cardIndex = i;
                                    var card = _deck.Cards[cardIndex];
                                    var isSelected = _selectedCard == card;
                                    <tr class="@(isSelected ? "table-active border-warning" : "")" style="cursor: pointer;" @onclick="() => SelectCard(card)">
                                        <td class="text-muted small">@(cardIndex + 1)</td>
                                        <td>
                                            <div class="fw-semibold @(isSelected ? "text-amber" : "text-light")">
                                                @(string.IsNullOrWhiteSpace(card.Name) ? "(...)" : card.Name)
                                            </div>
                                            <div class="small text-muted text-truncate" style="max-width: 220px;">
                                                @(string.IsNullOrWhiteSpace(card.Effect) ? card.Fluff : card.Effect)
                                            </div>
                                        </td>
                                        <td>
                                            <span class="badge rounded-pill @GetBadgeClassForColor(card.Type)">
                                                @card.Type
                                            </span>
                                        </td>
                                        <td class="small text-muted">@(card.Cost ?? "—")</td>
                                        <td class="small text-muted">@(card.Range ?? "—")</td>
                                        <td class="small">
                                            @if (card.Tracker is { Count: > 0 })
                                            {
                                                <span class="badge bg-secondary">@card.Tracker.Label: @card.Tracker.Count</span>
                                            }
                                            @if (card.TrackerRows is { Count: > 0 })
                                            {
                                                <span class="badge bg-dark-subtle text-light ms-1">@card.TrackerRows.Count</span>
                                            }
                                            @if ((card.Tracker is null || card.Tracker.Count <= 0) && (card.TrackerRows is null || card.TrackerRows.Count == 0))
                                            {
                                                <span class="text-muted">—</span>
                                            }
                                        </td>
                                        <td class="text-end" @onclick:stopPropagation="true">
                                            <button class="btn btn-sm btn-link text-info p-0 me-2" title="Kopieren" @onclick="() => DuplicateCard(card)">⎘</button>
                                            <button class="btn btn-sm btn-link text-danger p-0" title="Entfernen" @onclick="() => RemoveCard(card)">✕</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            <!-- Detail Editor for Selected Card -->
            @if (_selectedCard is not null)
            {
                <div class="glass-panel p-4 mb-4 glass-panel-gold">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="fw-bold text-amber mb-0">@I18n.T("edit.title") @(_selectedCard.Name)</h5>
                        <div class="d-flex align-items-center gap-2">
                            <button class="btn btn-outline-info btn-sm" @onclick="() => TranslateCard(_selectedCard)" title="Übersetzt diese Karte in die aktuell gewählte Sprache">
                                🌐 @I18n.T("gen.btn.translate_card")
                            </button>
                            <button class="btn btn-outline-primary btn-sm" @onclick="() => ConvertCardUnits(_selectedCard)" title="Rechnet Reichweiten dieser Karte um (m ⇄ ft)">
                                📏 @(I18n.CurrentUnitSystem switch { UnitSystem.Metric => "→ m", UnitSystem.Imperial => "→ ft", _ => "→ m & ft" })
                            </button>
                            <span class="small text-muted d-none d-md-inline">@I18n.T("edit.live_hint")</span>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small text-muted">@I18n.T("edit.name") (max. @CardTextLimits.Name)</label>
                            <input class="form-control" maxlength="@CardTextLimits.Name" @bind="_selectedCard.Name" @bind:event="oninput" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small text-muted">@I18n.T("edit.type")</label>
                            <select class="form-select" @bind="_selectedCard.Type">
                                @foreach (var color in Enum.GetValues<CardColor>())
                                {
                                    <option value="@color">@color</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small text-muted">@I18n.T("edit.cost") (max. @CardTextLimits.Cost)</label>
                            <input class="form-control" placeholder="@I18n.T("edit.cost_placeholder")" maxlength="@CardTextLimits.Cost" @bind="_selectedCard.Cost" @bind:event="oninput" />
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <label class="form-label small text-muted mb-0">@I18n.T("edit.range") (max. @CardTextLimits.Range)</label>
                                <div class="btn-group btn-group-sm" role="group">
                                    <button type="button" class="btn btn-outline-secondary py-0 px-1 small" style="font-size: 0.72rem;" @onclick='() => SetQuickRange(_selectedCard, I18n.CurrentLanguage == "de" ? "Selbst" : "Self")'>@(I18n.CurrentLanguage == "de" ? "Selbst" : "Self")</button>
                                    <button type="button" class="btn btn-outline-secondary py-0 px-1 small" style="font-size: 0.72rem;" @onclick='() => SetQuickRange(_selectedCard, I18n.CurrentLanguage == "de" ? "Berührung" : "Touch")'>@(I18n.CurrentLanguage == "de" ? "Berührung" : "Touch")</button>
                                    <button type="button" class="btn btn-outline-secondary py-0 px-1 small" style="font-size: 0.72rem;" @onclick='() => SetQuickRange(_selectedCard, I18n.CurrentUnitSystem switch { UnitSystem.Metric => "9 m", UnitSystem.Imperial => "30 ft", _ => "9 m (30 ft)" })'>@(I18n.CurrentUnitSystem switch { UnitSystem.Metric => "9 m", UnitSystem.Imperial => "30 ft", _ => "9 m (30 ft)" })</button>
                                    <button type="button" class="btn btn-outline-secondary py-0 px-1 small" style="font-size: 0.72rem;" @onclick='() => SetQuickRange(_selectedCard, I18n.CurrentUnitSystem switch { UnitSystem.Metric => "18 m", UnitSystem.Imperial => "60 ft", _ => "18 m (60 ft)" })'>@(I18n.CurrentUnitSystem switch { UnitSystem.Metric => "18 m", UnitSystem.Imperial => "60 ft", _ => "18 m (60 ft)" })</button>
                                </div>
                            </div>
                            <input class="form-control" placeholder="@I18n.T("edit.range_placeholder")" maxlength="@CardTextLimits.Range" @bind="_selectedCard.Range" @bind:event="oninput" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small text-muted">@I18n.T("edit.tracker")</label>
                            <div class="input-group">
                                <input class="form-control" placeholder="@I18n.T("edit.tracker_label_placeholder")" maxlength="@CardTextLimits.TrackerLabel"
                                       @bind:get="_selectedCard.Tracker?.Label ?? string.Empty" @bind:set="v => SetTrackerLabel(_selectedCard, v)" />
                                <input type="number" min="0" max="20" class="form-control" style="max-width: 80px;"
                                       @bind:get="_selectedCard.Tracker?.Count ?? 0" @bind:set="v => SetTrackerCount(_selectedCard, v)" />
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <div class="d-flex align-items-center gap-2">
                                <label class="form-label small text-muted mb-0">@I18n.T("edit.effect") (max. @_selectedCard.EffectiveEffectLimit)</label>
                                <div class="btn-group btn-group-sm" role="group" title="@I18n.T("edit.effect_size.hint")">
                                    <button type="button" class="btn btn-outline-secondary py-0 px-2 small @(_selectedCard.CustomEffectLimit is null or <= 0 ? "active bg-secondary text-white" : "")" style="font-size: 0.72rem;" @onclick="() => SetEffectSize(_selectedCard, null)">@I18n.T("edit.effect_size.auto")</button>
                                    <button type="button" class="btn btn-outline-secondary py-0 px-2 small @(_selectedCard.CustomEffectLimit == CardTextLimits.EffectStandard ? "active bg-secondary text-white" : "")" style="font-size: 0.72rem;" @onclick="() => SetEffectSize(_selectedCard, CardTextLimits.EffectStandard)">@I18n.T("edit.effect_size.standard")</button>
                                    <button type="button" class="btn btn-outline-secondary py-0 px-2 small @(_selectedCard.CustomEffectLimit == 360 ? "active bg-secondary text-white" : "")" style="font-size: 0.72rem;" @onclick="() => SetEffectSize(_selectedCard, 360)">@I18n.T("edit.effect_size.medium")</button>
                                    <button type="button" class="btn btn-outline-secondary py-0 px-2 small @(_selectedCard.CustomEffectLimit == CardTextLimits.EffectExpanded ? "active bg-secondary text-white" : "")" style="font-size: 0.72rem;" @onclick="() => SetEffectSize(_selectedCard, CardTextLimits.EffectExpanded)">@I18n.T("edit.effect_size.full")</button>
                                </div>
                            </div>
                            <span class="small text-muted">@((_selectedCard.Effect?.Length ?? 0))/@_selectedCard.EffectiveEffectLimit</span>
                        </div>
                        <textarea class="form-control" rows="@(_selectedCard.EffectiveEffectLimit > 300 ? 5 : 3)" maxlength="@_selectedCard.EffectiveEffectLimit" @bind="_selectedCard.Effect" @bind:event="oninput" placeholder="@I18n.T("edit.effect_placeholder")"></textarea>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <div class="d-flex justify-content-between align-items-center">
                                <label class="form-label small text-muted">@I18n.T("edit.fluff") (max. @CardTextLimits.Fluff)</label>
                                <span class="small text-muted">@((_selectedCard.Fluff?.Length ?? 0))/@CardTextLimits.Fluff</span>
                            </div>
                            <textarea class="form-control" rows="2" maxlength="@CardTextLimits.Fluff" @bind="_selectedCard.Fluff" @bind:event="oninput" placeholder="@I18n.T("edit.fluff_placeholder")"></textarea>
                        </div>
                        <div class="col-md-6">
                            <div class="d-flex justify-content-between align-items-center">
                                <label class="form-label small text-muted">@I18n.T("edit.tactic") (max. @CardTextLimits.Tactic)</label>
                                <span class="small text-muted">@((_selectedCard.Tactic?.Length ?? 0))/@CardTextLimits.Tactic</span>
                            </div>
                            <textarea class="form-control" rows="2" maxlength="@CardTextLimits.Tactic" @bind="_selectedCard.Tactic" @bind:event="oninput" placeholder="@I18n.T("edit.tactic_placeholder")"></textarea>
                        </div>
                    </div>

                    <!-- Multi-Tracker Rows (Optional) -->
                    <div class="border-top border-secondary pt-3 mt-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="small fw-semibold text-light">@I18n.T("edit.rows_title")</span>
                            <button class="btn btn-outline-secondary btn-sm" @onclick="() => AddTrackerRow(_selectedCard)">@I18n.T("edit.rows_add")</button>
                        </div>
                        @if (_selectedCard.TrackerRows is { Count: > 0 })
                        {
                            @for (var r = 0; r < _selectedCard.TrackerRows.Count; r++)
                            {
                                var row = _selectedCard.TrackerRows[r];
                                <div class="d-flex gap-2 mb-2 align-items-center">
                                    <input class="form-control form-control-sm" placeholder="Label" maxlength="@CardTextLimits.TrackerLabel" @bind="row.Label" />
                                    <input type="number" min="0" max="20" class="form-control form-control-sm" style="width: 80px;" @bind="row.Count" />
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => _selectedCard.TrackerRows.Remove(row)">✕</button>
                                </div>
                            }
                        }
                    </div>
                </div>
            }
        </div>

        <!-- Live Preview Pane -->
        <div class="col-lg-4">
            <div class="glass-panel p-4 position-sticky" style="top: 5rem;">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold text-light mb-0">👁️ @I18n.T("preview.title")</h5>
                    <span class="badge bg-secondary small">70 &times; 120 mm</span>
                </div>

                @if (_selectedCard is not null)
                {
                    <div class="d-flex justify-content-center py-2">
                        <div class="preview-card-frame @GetColorClass(_selectedCard.Type)">
                            <div class="preview-header">
                                @(string.IsNullOrWhiteSpace(_selectedCard.Name) ? I18n.T("preview.unnamed") : _selectedCard.Name)
                            </div>
                            <div class="preview-body">
                                @if (!string.IsNullOrWhiteSpace(_selectedCard.Cost))
                                {
                                    <div class="preview-stat-row">
                                        <span class="preview-stat-label">@I18n.T("preview.cost_label")</span> @_selectedCard.Cost
                                    </div>
                                }
                                @if (!string.IsNullOrWhiteSpace(_selectedCard.Range))
                                {
                                    <div class="preview-stat-row">
                                        <span class="preview-stat-label">@I18n.T("preview.range_label")</span> @_selectedCard.Range
                                    </div>
                                }

                                @if (_selectedCard.Tracker is { Count: > 0 } tr)
                                {
                                    <div class="d-flex align-items-center my-2">
                                        <span class="fw-bold me-2" style="font-size: 0.72rem; color: #555;">@tr.Label</span>
                                        <div class="d-flex flex-wrap gap-1">
                                            @for (var c = 0; c < tr.Count; c++)
                                            {
                                                <div class="preview-circle"></div>
                                            }
                                        </div>
                                    </div>
                                }

                                @if (!string.IsNullOrWhiteSpace(_selectedCard.Effect))
                                {
                                    <div class="preview-effect @(_selectedCard.EffectiveEffectLimit > 300 ? "expanded" : "")">@_selectedCard.Effect</div>
                                }
                                @if (!string.IsNullOrWhiteSpace(_selectedCard.Fluff))
                                {
                                    <div class="preview-fluff">"@_selectedCard.Fluff"</div>
                                }
                                @if (!string.IsNullOrWhiteSpace(_selectedCard.Tactic))
                                {
                                    <div class="preview-tactic-title mt-2">@I18n.T("preview.when_to_use")</div>
                                    <div class="preview-tactic">@_selectedCard.Tactic</div>
                                }

                                @if (_selectedCard.TrackerRows is { Count: > 0 } rows)
                                {
                                    <div class="mt-2 pt-2 border-top">
                                        @foreach (var row in rows)
                                        {
                                            <div class="mb-2 p-1 bg-white rounded shadow-sm">
                                                <div class="small fw-semibold mb-1" style="font-size: 0.72rem; color: #333;">@row.Label</div>
                                                <div class="d-flex flex-wrap gap-1">
                                                    @for (var rc = 0; rc < row.Count; rc++)
                                                    {
                                                        <div class="preview-circle"></div>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="text-center mt-3 text-muted small">
                        @I18n.T("preview.ratio_hint")
                    </div>
                }
                else
                {
                    <div class="text-center py-5 text-muted">
                        @I18n.T("preview.empty_hint")
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private CardDeck _deck => DeckState.Deck;
    private CardModel? _selectedCard
    {
        get => DeckState.SelectedCard;
        set => DeckState.SelectedCard = value;
    }
    private bool _isGenerating;
    private string? _statusMessage;
    private bool _statusIsError;
    private readonly string _clientId = Guid.NewGuid().ToString();

    protected override void OnInitialized()
    {
        I18n.OnLanguageChanged += StateHasChanged;
        I18n.OnUnitSystemChanged += StateHasChanged;

        if (_selectedCard is null && _deck.Cards.Count > 0)
        {
            _selectedCard = _deck.Cards.FirstOrDefault();
        }
    }

    private async Task TranslateCard(CardModel? card)
    {
        if (card is null) return;
        await TranslationService.TranslateCardAsync(card, I18n.CurrentLanguage);
        SetStatus(I18n.CurrentLanguage == "de"
            ? $"Karte '{card.Name}' wurde ins Deutsche übersetzt (inkl. D3 API Abgleich)."
            : $"Card '{card.Name}' translated to English (incl. D3 API lookup).", false);
    }

    private async Task TranslateDeck()
    {
        await TranslationService.TranslateDeckAsync(_deck, I18n.CurrentLanguage);
        SetStatus(I18n.CurrentLanguage == "de"
            ? $"{_deck.Cards.Count} Karten wurden ins Deutsche übersetzt (inkl. D3 API Abgleich)."
            : $"{_deck.Cards.Count} cards translated to English (incl. D3 API lookup).", false);
    }

    private void ConvertCardUnits(CardModel? card)
    {
        if (card is null) return;
        TranslationService.ConvertCardUnits(card, I18n.CurrentUnitSystem);
        var unitLabel = I18n.CurrentUnitSystem switch
        {
            UnitSystem.Metric => "Metrisch (m)",
            UnitSystem.Imperial => "Imperial (ft)",
            _ => "Beide (m & ft)"
        };
        SetStatus(I18n.CurrentLanguage == "de"
            ? $"Maßeinheiten von '{card.Name}' wurden nach {unitLabel} konvertiert."
            : $"Units of '{card.Name}' converted to {unitLabel}.", false);
    }

    private void ConvertDeckUnits()
    {
        TranslationService.ConvertDeckUnits(_deck, I18n.CurrentUnitSystem);
        var unitLabel = I18n.CurrentUnitSystem switch
        {
            UnitSystem.Metric => "Metrisch (m)",
            UnitSystem.Imperial => "Imperial (ft)",
            _ => "Beide (m & ft)"
        };
        SetStatus(I18n.CurrentLanguage == "de"
            ? $"Maßeinheiten aller {_deck.Cards.Count} Karten wurden nach {unitLabel} konvertiert."
            : $"Units of all {_deck.Cards.Count} cards converted to {unitLabel}.", false);
    }

    private static void SetQuickRange(CardModel? card, string rangeValue)
    {
        if (card is null) return;
        card.Range = rangeValue;
    }

    private static void SetEffectSize(CardModel? card, int? limit)
    {
        if (card is null) return;
        card.CustomEffectLimit = limit;
    }

    public void Dispose()
    {
        I18n.OnLanguageChanged -= StateHasChanged;
        I18n.OnUnitSystemChanged -= StateHasChanged;
    }

    private void SelectCard(CardModel card)
    {
        _selectedCard = card;
    }

    private void AddBlankCard()
    {
        var newCard = new CardModel { Name = "Neue Karte", Type = CardColor.Blue };
        _deck.Cards.Add(newCard);
        _selectedCard = newCard;
    }

    private void DuplicateCard(CardModel card)
    {
        var clone = new CardModel
        {
            Name = $"{card.Name} (Kopie)",
            Type = card.Type,
            Cost = card.Cost,
            Range = card.Range,
            Effect = card.Effect,
            Fluff = card.Fluff,
            Tactic = card.Tactic,
            Tracker = card.Tracker is not null ? new CardTracker { Label = card.Tracker.Label, Count = card.Tracker.Count } : null,
            TrackerRows = card.TrackerRows?.Select(r => new CardTracker { Label = r.Label, Count = r.Count }).ToList()
        };
        _deck.Cards.Add(clone);
        _selectedCard = clone;
        SetStatus($"Karte '{card.Name}' dupliziert.", false);
    }

    private void RemoveCard(CardModel card)
    {
        _deck.Cards.Remove(card);
        if (_selectedCard == card)
        {
            _selectedCard = _deck.Cards.FirstOrDefault();
        }
    }

    private static string GetColorClass(CardColor color) => color.ToString().ToLowerInvariant();

    private static string GetBadgeClassForColor(CardColor color) => color switch
    {
        CardColor.Red => "bg-danger",
        CardColor.Blue => "bg-primary",
        CardColor.Green => "bg-success",
        CardColor.Gold => "bg-warning text-dark",
        _ => "bg-secondary"
    };

    private static void SetTrackerCount(CardModel card, int count)
    {
        if (count <= 0 && string.IsNullOrWhiteSpace(card.Tracker?.Label))
        {
            card.Tracker = null;
            return;
        }
        card.Tracker ??= new CardTracker();
        card.Tracker.Count = count;
    }

    private static void SetTrackerLabel(CardModel card, string? label)
    {
        if (string.IsNullOrWhiteSpace(label) && (card.Tracker is null || card.Tracker.Count <= 0))
        {
            card.Tracker = null;
            return;
        }
        card.Tracker ??= new CardTracker();
        card.Tracker.Label = label ?? string.Empty;
    }

    private static void AddTrackerRow(CardModel card)
    {
        card.TrackerRows ??= [];
        card.TrackerRows.Add(new CardTracker { Label = "Zauberplätze", Count = 2 });
    }

    private async Task OnDeckJsonSelected(InputFileChangeEventArgs e)
    {
        try
        {
            await using var stream = e.File.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
            using var reader = new StreamReader(stream);
            var json = await reader.ReadToEndAsync();
            var deck = JsonSerializer.Deserialize<CardDeck>(json, JsonOptions);
            if (deck is not null)
            {
                DeckState.Deck = deck;
                _selectedCard = DeckState.Deck.Cards.FirstOrDefault();
                SetStatus($"{deck.Cards.Count} Karten geladen.", false);
            }
        }
        catch (Exception ex)
        {
            SetStatus($"Fehler beim Laden: {ex.Message}", true);
        }
    }

    private async Task OnDndBeyondJsonSelected(InputFileChangeEventArgs e)
    {
        try
        {
            await using var stream = e.File.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            using var reader = new StreamReader(stream);
            var json = await reader.ReadToEndAsync();
            var imported = DndBeyondImportService.Import(json, I18n.CurrentUnitSystem);
            _deck.Title = imported.Title;
            _deck.Cards.AddRange(imported.Cards);
            _selectedCard = _deck.Cards.FirstOrDefault();
            SetStatus($"{imported.Cards.Count} Karten aus D&D Beyond importiert. Bitte Texte prüfen und anpassen.", false);
        }
        catch (Exception ex)
        {
            SetStatus($"Import fehlgeschlagen: {ex.Message}", true);
        }
    }

    private async Task DownloadDeckJson()
    {
        var json = JsonSerializer.Serialize(_deck, JsonOptions);
        var bytes = System.Text.Encoding.UTF8.GetBytes(json);
        await JS.InvokeVoidAsync("downloadFileFromBytes", "karten.json", "application/json", Convert.ToBase64String(bytes));
    }

    private async Task DownloadHtml()
    {
        var html = CardHtmlBuilder.BuildHtml(_deck);
        var bytes = System.Text.Encoding.UTF8.GetBytes(html);
        await JS.InvokeVoidAsync("downloadFileFromBytes", $"{_deck.Title}.html", "text/html", Convert.ToBase64String(bytes));
        SetStatus("HTML erstellt.", false);
    }

    private async Task GeneratePng()
    {
        _isGenerating = true;
        try
        {
            var (bytes, fileName, contentType) = await ApiClient.RenderPngAsync(_deck, _clientId);
            await JS.InvokeVoidAsync("downloadFileFromBytes", fileName, contentType, Convert.ToBase64String(bytes));
            SetStatus("PNG erfolgreich über API erstellt.", false);
        }
        catch (Exception ex)
        {
            SetStatus($"PNG-Erstellung fehlgeschlagen: {ex.Message}", true);
        }
        finally
        {
            _isGenerating = false;
        }
    }

    private async Task GeneratePdf()
    {
        _isGenerating = true;
        try
        {
            var (bytes, fileName) = await ApiClient.RenderPdfAsync(_deck, _clientId);
            await JS.InvokeVoidAsync("downloadFileFromBytes", fileName, "application/pdf", Convert.ToBase64String(bytes));
            SetStatus("PDF erfolgreich über API erstellt.", false);
        }
        catch (Exception ex)
        {
            SetStatus($"PDF-Erstellung fehlgeschlagen: {ex.Message}", true);
        }
        finally
        {
            _isGenerating = false;
        }
    }

    private bool TryCheckUsageLimits(out int remaining)
    {
        remaining = 0;
        var maxCards = UsageLimitService.GetMaxCardsForClient(_clientId);
        if (_deck.Cards.Count > maxCards)
        {
            SetStatus($"Kostenlose Version ist auf {maxCards} Karten pro Set begrenzt. Bitte Kartenanzahl reduzieren oder Premium freischalten.", true);
            return false;
        }

        if (!UsageLimitService.TryConsumeGeneration(_clientId, out remaining))
        {
            SetStatus("Tageslimit für kostenlose Erstellungen erreicht. Bitte morgen erneut versuchen oder Premium freischalten.", true);
            return false;
        }

        return true;
    }

    private void SetStatus(string message, bool isError)
    {
        _statusMessage = message;
        _statusIsError = isError;
    }

    private static readonly JsonSerializerOptions JsonOptions = new(JsonSerializerDefaults.Web)
    {
        Converters = { new System.Text.Json.Serialization.JsonStringEnumConverter() }
    };
}
